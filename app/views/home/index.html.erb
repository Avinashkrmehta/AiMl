<h1>Welcome to Our Application</h1>

<% if user_signed_in? %>
  <div style="padding: 20px; background-color: #e7f3ff; border-radius: 8px; margin: 20px 0;">
    <h2>Hello, <%= current_user.email %>!</h2>
    <p>You are successfully logged in. This is a protected area of the application.</p>
    <p>Your account was created on: <%= current_user.created_at.strftime("%B %d, %Y") %></p>
    <p><%= link_to "Go to Dashboard →", dashboard_path, style: "text-decoration: none; padding: 8px 16px; background-color: #28a745; color: white; border-radius: 4px;" %></p>
  </div>
<% else %>
  <div style="padding: 20px; background-color: #fff3cd; border-radius: 8px; margin: 20px 0;">
    <h2>Welcome, Guest!</h2>
    <p>Please <%= link_to "sign up", new_user_registration_path %> or <%= link_to "log in", new_user_session_path %> to access all features.</p>
  </div>
<% end %>

<div style="margin-top: 30px;">
  <h3>Application Features:</h3>
  <ul>
    <li>User Registration and Authentication</li>
    <li>Secure Login/Logout</li>
    <li>Profile Management</li>
    <li>Protected Routes</li>
  </ul>
</div>
